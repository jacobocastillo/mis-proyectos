{
  "name": "streakup-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mobile": "node ./scripts/build-mobile.mjs",
    "sync:android": "npm run build:mobile && npx cap sync android",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import ./tests/register-aliases.mjs --test tests/unit/*.test.ts",
    "test:rf": "node --import ./tests/register-aliases.mjs --test tests/requirements/rf/*.test.ts",
    "test:rnf": "node --import ./tests/register-aliases.mjs --test tests/requirements/rnf/*.test.ts",
    "test:rnf:e2e": "playwright test --config tests/requirements/playwright.config.ts",
    "test:requirements": "npm run test:rf && npm run test:rnf && npm run test:rnf:e2e",
    "test:e2e": "playwright test --grep-invert @performance",
    "test:perf": "playwright test tests/e2e/performance.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@tailwindcss/postcss": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.14",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.8",
    "radix-ui": "^1.4.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.2.0",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
